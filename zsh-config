# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & PATHS (Static is faster than eval)
# ------------------------------------------------------------------------------
export HOMEBREW_PREFIX="/opt/homebrew"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export FPATH="/Users/dodo/.zsh/completions:$(brew --prefix)/share/zsh-completions:$FPATH"

# RUBY OPTIMIZATION
# We set the path manually to avoid calling the 'gem' binary on every startup.
if [ -d "/opt/homebrew/opt/ruby/bin" ]; then
  export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
  # This finds the current Homebrew ruby gem bin without running the slow 'gem' command
  export PATH="$(echo /opt/homebrew/lib/ruby/gems/*/bin | awk '{print $NF}'):$PATH"
fi

# JAVA & ANDROID
export JAVA_HOME="/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home"
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools"

# ------------------------------------------------------------------------------
# 2. LAZY LOADING (The speed secret)
# ------------------------------------------------------------------------------
# NVM: Only loads when you actually type 'node', 'npm', or 'nvm'
export NVM_DIR="$HOME/.nvm"
nvm() {
  unset -f nvm node npm npx
  [ -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ] && \. "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"
  nvm "$@"
}
node() { nvm >/dev/null; node "$@" }
npm() { nvm >/dev/null; npm "$@" }
npx() { nvm >/dev/null; npx "$@" }

# ------------------------------------------------------------------------------
# 3. COMPLETIONS & PLUGINS
# ------------------------------------------------------------------------------
# Fast compinit: only regenerates cache once a day
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.m-1) ]]; then
  compinit -C
else
  compinit
fi

source <(fzf --zsh)
source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source ~/.zsh/fzf-tab/fzf-tab.plugin.zsh

# ------------------------------------------------------------------------------
# 4. BETTER SUGGESTIONS & UI TWEAKS
# ------------------------------------------------------------------------------
# Strategy: Try to predict based on history, then the completion engine
export ZSH_AUTOSUGGEST_STRATEGY=(history completion)
export ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

# Case-insensitive tab completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no

# FZF-Tab: Rich previews for the tools you use
# Preview directories with 'ls' and files with 'cat' (or 'bat' if you have it)
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls -1F --color $realpath'
zstyle ':fzf-tab:complete:*:*' fzf-preview '[[ -d $realpath ]] && ls -1F --color $realpath || cat $realpath'

# ------------------------------------------------------------------------------
# 5. HISTORY & ALIASES
# ------------------------------------------------------------------------------
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
setopt appendhistory sharehistory hist_ignore_space hist_ignore_all_dups hist_save_no_dups
alias ls='ls --color'

# ------------------------------------------------------------------------------
# 6. PROMPT (Restored Git Info)
# ------------------------------------------------------------------------------
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats '%b'
zstyle ':vcs_info:*' enable git

COLOR_DEF=$'%f'
COLOR_USR=$'%F{243}'
COLOR_DIR=$'%F{155}'
COLOR_GIT=$'%F{39}'
COLOR_GIT_INFO=$'%F{208}'

git_prompt_info() {
  if git rev-parse --is-inside-work-tree &>/dev/null; then
    local branch stash_count ahead_behind ahead behind staged unstaged untracked
    local git_info=""

    # 1. Get branch name
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

    # 2. Get stash count
    stash_count=$(git stash list 2>/dev/null | wc -l | tr -d ' ')

    # 3. Get ahead/behind info
    ahead_behind=$(git rev-list --left-right --count @{upstream}...HEAD 2>/dev/null)
    if [ -n "$ahead_behind" ]; then
      behind=$(echo $ahead_behind | awk '{print $1}')
      ahead=$(echo $ahead_behind | awk '{print $2}')
    fi

    # 4. Get file statuses
    # Staged: Files in the index
    staged=$(git diff --cached --name-only 2>/dev/null | wc -l | tr -d ' ')

    # Unstaged: Modified files not yet staged
    unstaged=$(git diff --name-only 2>/dev/null | wc -l | tr -d ' ')

    # Untracked: New files not yet tracked
    untracked=$(git ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')

    # Build the display string
    local parts=()
    [ "$stash_count" -gt 0 ] && parts+=("${stash_count}*")
    [ "$behind" -gt "0" ]    && parts+=("${behind}↓")
    [ "$ahead" -gt "0" ]     && parts+=("${ahead}↑")
    [ "$unstaged" -gt "0" ]  && parts+=("${unstaged}?")
    [ "$untracked" -gt "0" ] && parts+=("${untracked}±")
    [ "$staged" -gt "0" ]    && parts+=("${staged}!")

    git_info="${parts[*]}"

    if [ -n "$git_info" ]; then
      echo " ${COLOR_GIT}[$branch] ${COLOR_GIT_INFO}$git_info"
    else
      echo " ${COLOR_GIT}[$branch]"
    fi
  fi
}

setopt PROMPT_SUBST
export PROMPT='
%F${COLOR_USR}%*%f ${COLOR_DIR}%~$(git_prompt_info)
${COLOR_DEF}$ '
